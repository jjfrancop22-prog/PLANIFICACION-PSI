rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function activeUser() { return signedIn() && userProfile().data.status == 'ACTIVO'; }
    function isBoss() { return activeUser() && userProfile().data.role == 'JEFE'; }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isBoss());
      allow create, update, delete: if isBoss();
    }

    // EXPERIMENTAL: vincula una actualización del catálogo con una confirmación
    // simultánea en planning. No verifica cada elemento de reagentConfig.
    function inventoryCommitAllowed() {
      let pid = request.resource.data.get('inventoryCommitPlanId', '');
      let receipt = request.resource.data.get('inventoryCommitReceiptId', '');
      let before = get(/databases/$(database)/documents/planning/$(pid)).data;
      let after = getAfter(/databases/$(database)/documents/planning/$(pid)).data;
      let prior = before.get('reagentResult', {});
      let wasZero = prior.get('completed', false) == true
        && prior.get('inventoryReceiptId', '') == ''
        && prior.get('items', []).size() == 1
        && prior.get('items', [])[0].get('notUsed', false) == true
        && prior.get('items', [])[0].get('used', -1) == 0;
      return pid is string && pid.size() > 0 && pid.size() < 150
        && receipt == 'INV-' + pid
        && before.get('completionCommittedAt', null) == null
        && before.get('status', '') != 'REALIZADO'
        && (prior.get('inventoryCommittedAt', null) == null || wasZero)
        && after.get('reagentResult', {}).get('completed', false) == true
        && after.get('reagentResult', {}).get('inventoryReceiptId', '') == receipt
        && after.get('reagentResult', {}).get('inventoryCommittedAt', null) is string
        && request.resource.data.updatedAt == after.updatedAt;
    }
    match /catalog/{id} {
      allow read: if activeUser();
      allow create, delete: if isBoss();
      allow update: if isBoss() || (activeUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reagentConfig', 'updatedAt', 'inventoryCommitPlanId', 'inventoryCommitReceiptId'
        ]) && inventoryCommitAllowed());
    }
    match /timeRules/{id} { allow read: if activeUser(); allow write: if isBoss(); }
    match /compositeSteps/{id} { allow read: if activeUser(); allow write: if isBoss(); }
    match /analysts/{id} { allow read: if activeUser(); allow write: if isBoss(); }
    match /planning/{id} {
      allow read: if activeUser();
      allow create, delete: if isBoss();
      // El cierre confirmado es irreversible mediante sincronización ordinaria.
      // No afecta actividades sin cierre ni la edición de otros campos.
      allow update: if activeUser() && (
        !(resource.data.status == 'REALIZADO' || resource.data.get('completionCommittedAt', null) != null)
        || (request.resource.data.status == 'REALIZADO' && request.resource.data.get('completionCommittedAt', null) != null)
      );
    }
    match /planComments/{id} {
      allow read, create: if activeUser();
      allow update, delete: if isBoss();
    }
    // Cartas de Control: configuración exclusiva de JEFE; registros para usuarios activos.
    match /controlChartDefs/{id} {
      allow read: if activeUser();
      allow create, update, delete: if isBoss();
    }
    match /controlChartRecords/{id} {
      allow read, create: if activeUser();
      allow update: if activeUser();
      allow delete: if isBoss();
    }
    // Diagnóstico por usuario: JEFE ve todo; cada analista solo su documento.
    match /syncHealth/{userId} {
      allow read: if isBoss() || (activeUser() && request.auth.uid == userId);
      allow create, update: if activeUser() && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == userProfile().data.role
        && request.resource.data.name == userProfile().data.name;
      allow delete: if false;
    }
    match /audit/{id} {
      allow read: if isBoss();
      allow create: if activeUser();
      allow update, delete: if false;
    }
    match /config/{id} { allow read, write: if isBoss(); }
    match /{document=**} { allow read, write: if false; }
  }
}
